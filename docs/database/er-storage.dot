digraph ER {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.85", splines=polyline];
node [shape=plain,fontname="Arial"];
edge [fontname="Arial",fontsize=10,color="#6c839e",arrowsize=0.75,dir=both];
"public.users" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b8c8da"><TR><TD COLSPAN="3" BGCOLOR="#dfeee8"><FONT POINT-SIZE="17"><B>users</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">PK</FONT></TD><TD ALIGN="LEFT" PORT="id"><FONT POINT-SIZE="14">id</FONT></TD><TD><FONT POINT-SIZE="11">uuid</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">UQ</FONT></TD><TD ALIGN="LEFT" PORT="username"><FONT POINT-SIZE="14">username</FONT></TD><TD><FONT POINT-SIZE="11">varchar(32)</FONT></TD></TR></TABLE>>];

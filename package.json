{
  "name": "remake",
  "type": "module",
  "version": "3.0.0",
  "author": "Vick Scarlet <vick@syaro.io>",
  "scripts": {
    "setup:local": "node packages/database/scripts/export-source.mjs && node packages/database/scripts/local-postgres.mjs setup && pnpm build:web",
    "start:local": "node packages/database/scripts/start-local.mjs",
    "db:start": "node packages/database/scripts/local-postgres.mjs start",
    "db:stop": "node packages/database/scripts/local-postgres.mjs stop",
    "db:export-source": "node packages/database/scripts/export-source.mjs",
    "db:test:real": "node --test packages/database/test/real.test.mjs",
    "db:verify-persistence": "node packages/database/scripts/verify-persistence.mjs",
    "db:migrate": "pnpm --filter @remake/database run migrate",
    "db:status": "pnpm --filter @remake/database run status",
    "db:rollback": "pnpm --filter @remake/database run rollback",
    "db:seed": "pnpm --filter @remake/database run seed",
    "db:test": "pnpm --filter @remake/database run test",
    "db:docs": "pnpm --filter @remake/database run docs",
    "dev": "pnpm --filter @remake/web dev",
    "dev:console": "pnpm --filter @syaroio/remake dev",
    "dev:prod": "pnpm --filter @remake/web dev:prod",
    "build:console": "pnpm --filter @syaroio/remake build",
    "build:web": "pnpm --filter @remake/web build",
    "build:bili": "pnpm --filter @remake/web build:bili",
    "build:data": "pnpm --filter @remake/data build",
    "preview": "pnpm --filter @remake/web preview",
    "start": "pnpm --filter @syaroio/remake start",
    "lint": "bunx --bun eslint",
    "lint:console": "pnpm --filter @syaroio/remake lint",
    "lint:web": "pnpm --filter @remake/web lint",
    "lint:core": "pnpm --filter @remake/core lint",
    "lint:data": "pnpm --filter @remake/data lint",
    "lint:condition": "pnpm --filter @remake/condition lint",
    "lint:hooks": "pnpm --filter @remake/hooks lint",
    "fix": "bunx --bun eslint --fix",
    "fix:console": "pnpm --filter @syaroio/remake lint --fix",
    "fix:web": "pnpm --filter @remake/web lint --fix",
    "fix:core": "pnpm --filter @remake/core lint --fix",
    "fix:data": "pnpm --filter @remake/data lint --fix",
    "fix:condition": "pnpm --filter @remake/condition lint --fix",
    "fix:hooks": "pnpm --filter @remake/hooks lint --fix",
    "test": "pnpm test:rules && pnpm test:hooks && pnpm test:web",
    "test:console": "pnpm --filter @syaroio/remake test",
    "test:web": "pnpm --filter @remake/web test",
    "test:core": "pnpm --filter @remake/core test",
    "test:data": "pnpm --filter @remake/data test",
    "test:condition": "pnpm --filter @remake/condition test",
    "test:hooks": "pnpm --filter @remake/hooks test",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "test:rules": "bun test ./packages/condition/ ./packages/core/ ./packages/data/ ./packages/vitex/"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "thirdparty/*"
  ]
}
